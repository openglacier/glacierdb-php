        "ogd",
        "database",
        "msgpack"
    ],
    "homepage": "https://forge.openglacier.org/openglacier/platform",
    "type": "library",
    "license": "MIT",
    "authors": [
        {
            "name": "OpenGlacier contributors",
            "homepage": "https://openglacier.org"
        }
    ],
    "support": {
